<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'EdgeGateway.BrokerMqtt' Or '$(MSBuildProjectName)' == 'EdgeGateway.DataAcquisition' Or '$(MSBuildProjectName)' == 'Device.Simulator' Or '$(MSBuildProjectName)' == 'Demo.Control' Or '$(MSBuildProjectName)' == 'Application.Api'">
    <None Include="$(MSBuildThisFileDirectory)appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('$(MSBuildThisFileDirectory)appsettings.json')" />
  </ItemGroup>
</Project>
